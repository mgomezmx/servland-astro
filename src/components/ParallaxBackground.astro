---
---
<div class="fixed inset-0 -z-10 overflow-hidden">
  <!-- Professional multi-layer gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-purple-50 to-blue-100 dark:from-gray-900 dark:via-blue-950 dark:to-purple-950"></div>
  
  <!-- Animated gradient overlay for depth and movement -->
  <div class="absolute inset-0 gradient-animation"></div>
  
  <!-- Subtle geometric pattern overlay -->
  <div class="absolute inset-0 geometric-pattern opacity-[0.04] dark:opacity-[0.06]"></div>
  
  <!-- Soft vignette effect -->
  <div class="absolute inset-0 bg-gradient-radial from-transparent via-transparent to-white/20 dark:to-black/20"></div>
</div>

<style>
  /* Animated gradient for subtle movement */
  .gradient-animation {
    background: linear-gradient(
      135deg,
      rgba(99, 102, 241, 0.1) 0%,
      rgba(168, 85, 247, 0.1) 25%,
      rgba(59, 130, 246, 0.1) 50%,
      rgba(147, 51, 234, 0.1) 75%,
      rgba(99, 102, 241, 0.1) 100%
    );
    background-size: 400% 400%;
  }

  /* Respect user's motion preferences */
  @media (prefers-reduced-motion: no-preference) {
    .gradient-animation {
      animation: gradient-shift 20s ease infinite;
    }
  }

  @keyframes gradient-shift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Modern geometric pattern */
  .geometric-pattern {
    background-image:
      linear-gradient(30deg, rgba(99, 102, 241, 0.15) 12%, transparent 12.5%, transparent 87%, rgba(99, 102, 241, 0.15) 87.5%, rgba(99, 102, 241, 0.15)),
      linear-gradient(150deg, rgba(99, 102, 241, 0.15) 12%, transparent 12.5%, transparent 87%, rgba(99, 102, 241, 0.15) 87.5%, rgba(99, 102, 241, 0.15)),
      linear-gradient(30deg, rgba(99, 102, 241, 0.15) 12%, transparent 12.5%, transparent 87%, rgba(99, 102, 241, 0.15) 87.5%, rgba(99, 102, 241, 0.15)),
      linear-gradient(150deg, rgba(99, 102, 241, 0.15) 12%, transparent 12.5%, transparent 87%, rgba(99, 102, 241, 0.15) 87.5%, rgba(99, 102, 241, 0.15)),
      linear-gradient(60deg, rgba(168, 85, 247, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(168, 85, 247, 0.1) 75%, rgba(168, 85, 247, 0.1)),
      linear-gradient(60deg, rgba(168, 85, 247, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(168, 85, 247, 0.1) 75%, rgba(168, 85, 247, 0.1));
    background-size: 80px 140px;
    background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0, 40px 70px;
  }

  /* Radial gradient utility */
  .bg-gradient-radial {
    background: radial-gradient(circle at center, var(--tw-gradient-stops));
  }

  /* Dark mode adjustments */
  .dark .geometric-pattern {
    background-image:
      linear-gradient(30deg, rgba(147, 197, 253, 0.1) 12%, transparent 12.5%, transparent 87%, rgba(147, 197, 253, 0.1) 87.5%, rgba(147, 197, 253, 0.1)),
      linear-gradient(150deg, rgba(147, 197, 253, 0.1) 12%, transparent 12.5%, transparent 87%, rgba(147, 197, 253, 0.1) 87.5%, rgba(147, 197, 253, 0.1)),
      linear-gradient(30deg, rgba(147, 197, 253, 0.1) 12%, transparent 12.5%, transparent 87%, rgba(147, 197, 253, 0.1) 87.5%, rgba(147, 197, 253, 0.1)),
      linear-gradient(150deg, rgba(147, 197, 253, 0.1) 12%, transparent 12.5%, transparent 87%, rgba(147, 197, 253, 0.1) 87.5%, rgba(147, 197, 253, 0.1)),
      linear-gradient(60deg, rgba(196, 181, 253, 0.08) 25%, transparent 25.5%, transparent 75%, rgba(196, 181, 253, 0.08) 75%, rgba(196, 181, 253, 0.08)),
      linear-gradient(60deg, rgba(196, 181, 253, 0.08) 25%, transparent 25.5%, transparent 75%, rgba(196, 181, 253, 0.08) 75%, rgba(196, 181, 253, 0.08));
  }

  /* Performance optimization */
  .gradient-animation,
  .geometric-pattern {
    will-change: background-position;
  }

  /* Disable animations for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gradient-animation {
      animation: none;
    }
  }
</style>