<div class="fixed inset-0 -z-10 overflow-hidden">
  <!-- Professional gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-white to-purple-50 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900"></div>
  
  <!-- Cityscape background with improved visibility -->
  <div class="absolute inset-0 cityscape-background" role="presentation"></div>
  
  <!-- Subtle overlay for depth -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/30 to-white/50 dark:via-gray-900/30 dark:to-gray-900/50"></div>
  
  <!-- Refined grid pattern -->
  <div class="absolute inset-0 bg-grid-pattern opacity-[0.03] dark:opacity-[0.08]"></div>
</div>

<style>
  .cityscape-background {
    background-image: url('/sl-sky.webp');
    background-position: bottom center;
    background-size: cover;
    background-repeat: no-repeat;
    transform-origin: bottom;
    opacity: 0.35;
    will-change: transform;
  }

  /* Respect user's motion preferences */
  @media (prefers-reduced-motion: no-preference) {
    .cityscape-background {
      animation: subtle-parallax 30s ease-in-out infinite;
    }
  }

  @keyframes subtle-parallax {
    0%, 100% {
      transform: translateY(0) scale(1.02);
    }
    50% {
      transform: translateY(-10px) scale(1);
    }
  }

  .bg-grid-pattern {
    background-image:
      linear-gradient(to right, rgba(59, 130, 246, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(59, 130, 246, 0.1) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* Dark mode grid adjustment */
  .dark .bg-grid-pattern {
    background-image:
      linear-gradient(to right, rgba(147, 197, 253, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(147, 197, 253, 0.1) 1px, transparent 1px);
  }
</style>

<script>
  // Optimized parallax effect with requestAnimationFrame
  let ticking = false;
  let lastScrollY = 0;

  function updateParallax() {
    const cityscape = document.querySelector('.cityscape-background') as HTMLElement;
    if (cityscape && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const scrolled = lastScrollY;
      const rate = scrolled * 0.1;
      cityscape.style.transform = `translateY(${rate}px) scale(${1 + scrolled * 0.00005})`;
    }
    ticking = false;
  }

  function onScroll() {
    lastScrollY = window.pageYOffset;
    if (!ticking) {
      window.requestAnimationFrame(updateParallax);
      ticking = true;
    }
  }

  // Only add scroll listener if user hasn't requested reduced motion
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>