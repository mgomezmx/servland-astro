---
// Floating WhatsApp button for better mobile accessibility
---

<a
  href="https://wa.me/523333804784?text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20cita%20en%20Ortodens"
  target="_blank"
  rel="noopener noreferrer"
  class="floating-whatsapp"
  aria-label="Contactar por WhatsApp"
  title="Chatea con nosotros"
  id="floating-whatsapp-btn"
  data-conversion-action="whatsapp_click"
>
  <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
  </svg>
  <span class="pulse-ring"></span>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 1000;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .floating-whatsapp:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
  }

  .floating-whatsapp:active {
    transform: scale(0.95);
  }

  .pulse-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 2px solid #25D366;
    border-radius: 50%;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* Mobile optimization */
  @media (max-width: 640px) {
    .floating-whatsapp {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 56px;
      height: 56px;
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp {
      transition: none;
    }
    
    .pulse-ring {
      animation: none;
    }
    
    .floating-whatsapp:hover {
      transform: none;
    }
  }
</style>

<script>
  // Conversion tracking for WhatsApp clicks
  document.addEventListener('DOMContentLoaded', () => {
    const whatsappBtn = document.getElementById('floating-whatsapp-btn');
    
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', () => {
        // Google Analytics event tracking
        if (typeof gtag !== 'undefined') {
          gtag('event', 'conversion', {
            'send_to': 'AW-CONVERSION_ID/CONVERSION_LABEL', // Replace with your actual conversion ID
            'event_category': 'engagement',
            'event_label': 'WhatsApp Click - Floating Button',
            'value': 1
          });
          
          // Track as custom event
          gtag('event', 'whatsapp_click', {
            'event_category': 'contact',
            'event_label': 'Floating WhatsApp Button',
            'value': 1
          });
        }
        
        // Facebook Pixel tracking (if you use it)
        if (typeof fbq !== 'undefined') {
          fbq('track', 'Contact', {
            content_name: 'WhatsApp Click',
            content_category: 'Contact'
          });
        }
      });
    }
  });
</script>